{
  "name": "scenario-sender",
  "productName": "シナリオ送信ビューア",
  "version": "0.4.0",
  "description": "閲覧用HTMLを開き、本文クリックでココフォリアのチャットへ送信するデスクトップアプリ",
  "repository": {
    "type": "git",
    "url": "https://github.com/8i10/scenarioeditor.git"
  },
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "release:mac": "electron-builder --mac dmg zip --publish always"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.8i10.scenario-sender",
    "productName": "シナリオ送信ビューア",
    "artifactName": "scenario-sender-${version}-${os}-${arch}.${ext}",
    "files": [
      "**/*",
      "!dist{,/**}",
      "!README.md"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "8i10",
        "repo": "scenarioeditor",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
